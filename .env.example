# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# AI & Vision
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Nutrition APIs
USDA_API_KEY=your_usda_api_key_here
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here

# Database
# For local Docker: postgresql+asyncpg://foodshot:foodshot_pass@db:5432/foodshot
# For Neon (Remote): postgresql+asyncpg://user:pass@ep-custom-name-123456.eu-central-1.aws.neon.tech/dbname
POSTGRES_USER=foodshot
POSTGRES_PASSWORD=foodshot_pass
POSTGRES_DB=foodshot
DATABASE_URL=postgresql+asyncpg://foodshot:foodshot_pass@db:5432/foodshot

# Redis
# For local Docker: redis://redis:6379/0
# For Upstash (Remote): rediss://default:password@eu1-custom-name-32132.upstash.io:32132
REDIS_URL=redis://redis:6379/0

# Webhook
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET_TOKEN=your_super_secret_token_here
PORT=8000
TIMEZONE_OFFSET_HOURS=3

# Cloudflare (Deployment)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
